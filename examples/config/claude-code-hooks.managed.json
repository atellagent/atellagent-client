{
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python -m atellagent_client.hook_launcher --host claude-code --socket /run/user/<uid>/atellagent/control.sock", "timeout": 20}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "python -m atellagent_client.hook_launcher --host claude-code --socket /run/user/<uid>/atellagent/control.sock", "timeout": 20}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "python -m atellagent_client.hook_launcher --host claude-code --socket /run/user/<uid>/atellagent/control.sock", "timeout": 20}]}],
    "PostToolUseFailure": [{"hooks": [{"type": "command", "command": "python -m atellagent_client.hook_launcher --host claude-code --socket /run/user/<uid>/atellagent/control.sock", "timeout": 20}]}]
  }
}
