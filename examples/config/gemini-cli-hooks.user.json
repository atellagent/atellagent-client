    "BeforeTool": [{"matcher": ".*", "hooks": [{"name": "atellagent-before-tool", "type": "command", "command": "/usr/local/bin/python -m atellagent_client.hook_launcher --host gemini-cli --socket /run/user/<uid>/atellagent/control.sock", "timeout": 20000}]}]
  }
}
